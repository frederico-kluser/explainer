# OpenAI API key — get one at https://platform.openai.com/api-keys
# The only required variable. It never reaches the browser: the backend mints a
# short-lived client secret per session and the browser gets that instead.
OPENAI_API_KEY=sk-proj-...

# --- Models and voice (all optional; defaults shown) ---

# The realtime speech-to-speech model the conversation runs on.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Voice used for the spoken answers (marin, cedar, alloy, ...).
# OPENAI_REALTIME_VOICE=marin

# Model behind the `web_search` tool (Responses API, hosted web search).
# The Realtime API has no built-in web search, so search runs here and comes
# back as a function result. Falls back to `surf-research-skill` if it fails.
# OPENAI_SEARCH_MODEL=gpt-5.2

# Model used for short text completions (conversation titles, summaries).
# OPENAI_TEXT_MODEL=gpt-5.2-mini

# --- pi coding agent (optional) ---
# Dispatched read-only against the selected repository. Without these it uses
# whatever ~/.pi/agent/settings.json already selects.
# PI_BIN=pi
# PI_PROVIDER=deepseek
# PI_MODEL=deepseek-v4-pro
# PI_THINKING=high
# PI_TIMEOUT_MS=180000

# --- Sources ---
# Documentation of this machine. Its `project-router` agent skill is the
# domain → document index the model consults first.
# EXPLAINER_MACHINE_DOCS=~/Projects/config

# Extra directories a *local* repo source may live under, colon-separated.
# ~/Projects and the clone cache are always allowed.
# EXPLAINER_REPO_ROOTS=/srv/code:/opt/repos

# --- Saldo da OpenAI (opcional) ---
# A OpenAI só expõe gastos para chaves de ADMINISTRAÇÃO. Uma chave de projeto
# (sk-proj-...) recebe 401 reclamando do escopo api.usage.read. Crie uma em
# platform.openai.com/settings/organization/admin-keys para ver o gasto dos
# últimos 30 dias no painel de custos.
# OPENAI_ADMIN_KEY=sk-admin-...

# --- Saldo dos outros provedores (opcional, já costumam estar no ambiente) ---
# Usadas só para mostrar quanto resta; o app não chama esses provedores.
# OPENROUTER_API_KEY=sk-or-v1-...
# DEEPSEEK_API_KEY=sk-...

# --- Server ---
# PORT=3001

# Motion+ token — already in global env, listed here for documentation only
# MOTION_TOKEN=...
