# OpenRouter API key — get at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# --- Model selection (all optional; defaults shown) ---
# Swapping a provider must never require a code change.

# LLM used for chat and summarization.
# OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4-pro

# Speech-to-text, via the /audio/transcriptions endpoint.
# OPENROUTER_STT_MODEL=openai/whisper-large-v3

# Text-to-speech strategy:
#   chat   — chat/completions with audio output (default; the only path
#            OpenRouter currently serves — it returns 24 kHz PCM, which the
#            backend wraps into WAV)
#   speech — the dedicated /audio/speech endpoint. As of this writing that
#            endpoint resolves no model ("Model X does not exist"); switch to
#            it once your account has a real TTS model.
# OPENROUTER_TTS_MODE=chat
# OPENROUTER_TTS_CHAT_MODEL=openai/gpt-audio-mini
# OPENROUTER_TTS_MODELS=mistral/mistral-tts,google/gemini-flash-tts
# OPENROUTER_TTS_VOICE=alloy

# Backend port (default 3001)
# PORT=3001

# Motion+ token — already in global env, listed here for documentation only
# MOTION_TOKEN=...
