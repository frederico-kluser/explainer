node_modules/
dist/
*.tsbuildinfo
.env
*.log
.DS_Store

# Certificado de desenvolvimento da LAN, emitido por scripts/dev-cert.mjs.
# Vale só para os IPs desta máquina neste momento — e lan-key.pem é uma chave
# privada. Cada máquina emite o seu ao rodar `npm run dev`.
.certs/
frontend/public/rootCA.pem

# Voice assistant data — stored at $XDG_DATA_HOME/voice-assistant
# (typically ~/.local/share/voice-assistant on Linux)

# Editor
.idea/
.vscode/
*.swp
*.swo

# Skills system: validation tokens are machine-local and short-lived.
# The regression BASELINE is committed on purpose — it is the reference a future
# update is judged against, so it belongs in review and in history.
.agents/skills/.validation/*.json
!.agents/skills/.validation/*.baseline.json
.agents/skills/.stop-attempts

# electron-vite build output
out/

# Screenshots, logs and throwaway XDG roots written by `npm run smoke:dev` and
# `npm run smoke:desktop`. Evidence of one run on one machine — the PNGs are
# what a human opens when a smoke goes red, not something to review in a diff.
.smoke/
